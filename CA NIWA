# One unique colour per species, including the two enzyme-bound complexes.
C_COL  = np.array([0.90, 0.00, 0.00])    # crystalline polymer        red
ZC_COL = np.array([0.50, 0.10, 0.60])    # crystalline complex        purple
A_COL  = np.array([0.10, 0.34, 0.70])    # amorphous polymer          blue
ZA_COL = np.array([0.10, 0.65, 0.25])    # amorphous complex          green
D_COL  = np.array([0.95, 0.70, 0.05])    # retained degraded polymer  amber
V_COL  = np.array([1.00, 1.00, 1.00])    # void                       white

# SUB-CELL SQUARE RENDERING, ONE PURE COLOUR PER SQUARE
# -----------------------------------------------------
# Each lattice cell is drawn as a SUBCELL_N x SUBCELL_N grid of square
# display pixels, K = SUBCELL_N**2 squares in total. No colours are blended:
# every square shows exactly one species in that species' own colour.
#
# With s = 1 - V the remaining solid fraction of a cell:
#
#   s <= VOID_THRESHOLD : the cell is VOID and drawn completely white;
#   s >  VOID_THRESHOLD : the cell has n_solid = max(1, round(s * K)) solid
#                         squares; the other squares are white void.
#
# The n_solid squares are shared between C, ZC, A, ZA and D in proportion to
# their mass fractions in the cell (largest-remainder rounding, so the counts
# always add up to n_solid). A species therefore appears in a cell once it
# holds roughly 1/K of the cell (about 2 % for SUBCELL_N = 7); smaller amounts,
# such as the retained degraded polymer D, are below the display resolution.
#
# Because transfers remove a proportion 1 - exp(-k dt) of what is present,
# eroding solid decays geometrically and never reaches exactly zero. A cell
# whose remaining solid is at most VOID_THRESHOLD (1e-6 of its initial mass)
# is therefore classed as void. This is a display and classification rule
# only; the simulated mass fractions are not altered.
#
# The model stores how much of each species a cell holds, not where it sits
# inside the cell. Each cell is therefore given ONE random order of its K
# squares, drawn once with DISPLAY_SEED and reused at every snapshot time.
# Squares become void in that order as V increases, so a square that is void
# at one time stays void at all later times, and the solid squares are filled
# in the fixed species order SPECIES_DRAW_ORDER. The random positions affect
# the figures only; the simulation, its seed and all reported results are
# unchanged.
SUBCELL_N = 7
VOID_THRESHOLD = 1.0e-6
DISPLAY_SEED = SEED0 + 500000     # separate from the simulation seed

_SQUARE_RANK_CACHE = {}


def square_removal_rank(nx, ny, n=SUBCELL_N):
    """
    Fixed removal order of the n x n squares of every cell,
    shape (nx, n, ny, n), indexed [i, sub-row, j, sub-column].

    rank = r means that square is the (r + 1)-th of its cell to be removed.
    The order is a random permutation per cell, drawn once and reused for
    every snapshot, so erosion is monotone in time.
    """
    key = (nx, ny, n)
    if key not in _SQUARE_RANK_CACHE:
        rng = np.random.default_rng(DISPLAY_SEED)
        keys = rng.random((nx, ny, n * n))
        rank = np.argsort(np.argsort(keys, axis=2), axis=2)
        rank = rank.reshape(nx, ny, n, n).transpose(0, 2, 1, 3)
        _SQUARE_RANK_CACHE[key] = rank
    return _SQUARE_RANK_CACHE[key]

# Solid squares are filled in this order, starting next to the void squares.
SPECIES_DRAW_ORDER = [STATE_D, STATE_ZA, STATE_ZC, STATE_A, STATE_C]

SPECIES_COLOURS = np.zeros((N_STATES, 3))
SPECIES_COLOURS[STATE_C] = C_COL
SPECIES_COLOURS[STATE_ZC] = ZC_COL
SPECIES_COLOURS[STATE_A] = A_COL
SPECIES_COLOURS[STATE_ZA] = ZA_COL
SPECIES_COLOURS[STATE_D] = D_COL
SPECIES_COLOURS[STATE_V] = V_COL

if len({tuple(np.round(c, 3)) for c in SPECIES_COLOURS}) != N_STATES:
    raise ValueError('Every species must have its own colour.')

PHASE_LEGEND = [
    Patch(facecolor=C_COL, edgecolor='black', label='Crystalline (C)'),
    Patch(facecolor=ZC_COL, edgecolor='black', label='Crystalline complex (ZC)'),
    Patch(facecolor=A_COL, edgecolor='black', label='Amorphous (A)'),
    Patch(facecolor=ZA_COL, edgecolor='black', label='Amorphous complex (ZA)'),
    Patch(facecolor=D_COL, edgecolor='black', label='Degraded (D)'),
    Patch(facecolor=V_COL, edgecolor='black', label='Void (V)'),
]

SEM_SOLID_COL = np.array([0.55, 0.55, 0.55])
SEM_VOID_COL  = np.array([1.00, 1.00, 1.00])
SEM_BW_LEGEND = [
    Patch(facecolor=SEM_SOLID_COL, edgecolor='black', label='Polymer solid (C, ZC, A, ZA, D)'),
    Patch(facecolor=SEM_VOID_COL, edgecolor='black', label='Void (V)'),
]


def phase_fractions(snapshot):
    f = snapshot['mass_fractions']

    return (
        f[:, :, STATE_C],
        f[:, :, STATE_A],
        f[:, :, STATE_ZC],
        f[:, :, STATE_ZA],
        f[:, :, STATE_D],
        f[:, :, STATE_V],
    )


def subcell_solid_mask(solid_fraction, n=SUBCELL_N):
    """
    Sub-cell square mask, shape (NX * n, NY * n).

    A cell with solid_fraction <= VOID_THRESHOLD is void and receives no solid
    squares. Any other cell receives max(1, round(solid_fraction * n * n))
    solid squares, capped at n * n; the n * n - n_solid squares with the
    lowest fixed removal rank are void.
    """
    nx, ny = solid_fraction.shape
    k = n * n
    s = np.clip(solid_fraction, 0.0, 1.0)

    n_solid = np.where(
        s <= VOID_THRESHOLD,
        0,
        np.clip(np.rint(s * k), 1, k),
    ).astype(np.int32)

    rank = square_removal_rank(nx, ny, n)
    mask = rank >= (k - n_solid)[:, None, :, None]

    return mask.reshape(nx * n, ny * n)


def solid_square_count(solid_fraction, n=SUBCELL_N):
    """Number of solid squares per cell (same rule as subcell_solid_mask)."""
    k = n * n
    s = np.clip(solid_fraction, 0.0, 1.0)
    return np.where(
        s <= VOID_THRESHOLD,
        0,
        np.clip(np.rint(s * k), 1, k),
    ).astype(np.int32)


def species_square_counts(snapshot, n=SUBCELL_N):
    """
    Squares given to each solid species in every cell, shape
    (len(SPECIES_DRAW_ORDER), NX, NY). The counts add up to the number of
    solid squares of the cell (largest-remainder rounding).
    """
    f = np.asarray(snapshot['mass_fractions'], dtype=np.float64)
    masses = np.stack([np.clip(f[:, :, st], 0.0, None) for st in SPECIES_DRAW_ORDER])
    solid = masses.sum(axis=0)

    n_solid = solid_square_count(solid, n)
    safe = np.where(solid > 0.0, solid, 1.0)
    quota = masses / safe * n_solid

    counts = np.floor(quota).astype(np.int32)
    left = n_solid - counts.sum(axis=0)

    # Give the squares still unassigned to the largest fractional parts.
    frac = quota - counts
    order = np.argsort(-frac, axis=0, kind='stable')
    position = np.argsort(order, axis=0, kind='stable')
    counts += (position < left[None, :, :]).astype(np.int32)

    return counts, n_solid


def fraction_preserving_phase_image(snapshot, n=SUBCELL_N):
    """
    Render the simulated composition of every lattice cell with one unique
    colour per species (C, ZC, A, ZA, D and void).

    Each cell is an n x n block of square pixels. A proportion (1 - V) of the
    squares is solid and the rest is white void. The solid squares are shared
    between the five solid species in proportion to their mass fractions, and
    each square is drawn in the pure colour of its species. Image shape is
    (NX * n, NY * n, 3).
    """
    counts, n_solid = species_square_counts(snapshot, n)
    nx, ny = n_solid.shape
    k = n * n

    rank = square_removal_rank(nx, ny, n)                 # (nx, n, ny, n)
    # Position of each square among the solid squares of its cell; negative
    # values are void squares.
    solid_index = rank - (k - n_solid)[:, None, :, None]

    image = np.empty((nx, n, ny, n, 3), dtype=np.float64)
    image[...] = V_COL

    upper = np.zeros((nx, ny), dtype=np.int32)
    for q, state in enumerate(SPECIES_DRAW_ORDER):
        lower = upper
        upper = lower + counts[q]
        sel = (
            (solid_index >= lower[:, None, :, None])
            & (solid_index < upper[:, None, :, None])
        )
        image[sel] = SPECIES_COLOURS[state]

    return image.reshape(nx * n, ny * n, 3)


def sem_binary_phase_image(snapshot, n=SUBCELL_N):
    """
    Render an SEM-style solid/void image.

    Each cell is an n x n block of square pixels; a proportion (1 - V) of the
    squares is grey polymer solid and the rest is white void. Image shape is
    (NX * n, NY * n, 3).
    """
    cf, af, zcf, zaf, df, vf = phase_fractions(snapshot)

    solid = np.clip(cf + af + zcf + zaf + df, 0.0, 1.0)
    mask = subcell_solid_mask(solid, n)

    return np.where(mask[:, :, None], SEM_SOLID_COL, SEM_VOID_COL)


