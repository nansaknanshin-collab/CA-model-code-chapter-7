def savefig_windows_safe(fig, path, *, dpi=None, bbox_inches='tight', facecolor='white'):
    """
    Save a figure as a true PNG without asking PIL to open the Windows path.

    Matplotlib renders the PNG into memory first. Python then writes the bytes
    to disk. If the requested path cannot be written, a short fallback path in
    Downloads/NIWA_PNG_EXPORTS is used.
    """
    path = Path(path).with_suffix('.png')
    path.parent.mkdir(parents=True, exist_ok=True)

    safe_name = ''.join(
        ch for ch in path.name
        if ord(ch) >= 32 and ch not in '<>:"/\\|?*'
    ).strip().rstrip('.')

    if not safe_name:
        raise ValueError(f'Invalid output filename derived from: {path!r}')

    safe_path = path.with_name(safe_name)

    buffer = io.BytesIO()
    kwargs = {
        'format': 'png',
        'bbox_inches': bbox_inches,
        'facecolor': facecolor,
    }
    if dpi is not None:
        kwargs['dpi'] = dpi

    fig.savefig(buffer, **kwargs)
    png_bytes = buffer.getvalue()
    buffer.close()

    try:
        safe_path.write_bytes(png_bytes)
        return safe_path
    except OSError:
        fallback_path = PNG_FALLBACK_DIR / safe_name
        fallback_path.write_bytes(png_bytes)
        return fallback_path


