def initialise_lattice(xc0, seed):
    """
    Initialise a spatially random C/A morphology.

    Exactly round(xc0 * NX * NY) cells are initially crystalline; the rest are
    amorphous. Each cell starts with one normalised unit of polymer mass.
    """
    n_cells = NX * NY
    rng = np.random.default_rng(int(seed))
    n_c = int(round(float(xc0) * n_cells))
    phase = np.zeros(n_cells, dtype=np.uint8)
    phase[:n_c] = 1
    rng.shuffle(phase)
    phase = phase.reshape(NX, NY)

    M = np.zeros((N_STATES, NX, NY), dtype=np.float64)
    M[STATE_C, :, :] = (phase == 1)
    M[STATE_A, :, :] = (phase == 0)

    E = np.zeros((NX, NY), dtype=np.float64)

    # Prescribed active enzyme at all exposed boundaries.
    E[0, :] = E_T
    E[-1, :] = E_T
    E[:, 0] = E_T
    E[:, -1] = E_T

    stats = dict(
        total_cells=int(n_cells),
        crystalline_cells=int(n_c),
        amorphous_cells=int(n_cells - n_c),
        realised_initial_Xc_pct=100.0 * n_c / n_cells,
        initial_mass_per_cell=1.0,
        total_initial_normalised_mass=float(n_cells),
    )

    return M, E, stats


# ================================================================
# REACTION STEP: NIWA ONLY
# ================================================================

@njit(cache=False)
def reaction_step(M, E, k2, kc, km, k1, ka, ke, dt, ET):
    """
    Apply the NIWA reaction network over one reaction step.

    The masses present at the START of the step determine eligibility.
    Thus:
      - newly generated D cannot erode in the same step;
      - newly generated A cannot bind in the same step;
      - newly generated ZC or ZA cannot turn over in the same step.

    There is no inhibition reaction and no inhibited-enzyme state.
    """
    nx = M.shape[1]
    ny = M.shape[2]

    kc_total = kc + km
    p_leave_c = 1.0 - np.exp(-kc_total * dt) if kc_total > 0.0 else 0.0
    branch_d = kc / kc_total if kc_total > 0.0 else 1.0

    p_leave_a = 1.0 - np.exp(-ka * dt) if ka > 0.0 else 0.0
    p_erode = 1.0 - np.exp(-ke * dt) if ke > 0.0 else 0.0

    released_mass = 0.0

    for i in range(nx):
        for j in range(ny):
            c0  = M[STATE_C,  i, j]
            a0  = M[STATE_A,  i, j]
            zc0 = M[STATE_ZC, i, j]
            za0 = M[STATE_ZA, i, j]
            d0  = M[STATE_D,  i, j]
            v0  = M[STATE_V,  i, j]

            e0 = E[i, j]
            if e0 < 0.0:
                e0 = 0.0

            p_attack_c = 1.0 - np.exp(-k2 * e0 * dt) if k2 > 0.0 else 0.0
            p_attack_a = 1.0 - np.exp(-k1 * e0 * dt) if k1 > 0.0 else 0.0

            # 1) Existing degraded polymer erodes:
            #       D -> P + V
            erode = d0 * p_erode
            d = d0 - erode
            v = v0 + erode
            released_mass += erode

            # 2) Existing amorphous complex degrades:
            #       ZA -> E + D
            za_to_d = za0 * p_leave_a
            za = za0 - za_to_d
            d += za_to_d

            # 3) Existing amorphous polymer binds enzyme:
            #       E + A -> ZA
            a_to_za = a0 * p_attack_a
            a = a0 - a_to_za
            za += a_to_za

            # 4) Existing crystalline complex either degrades or amorphises:
            #       ZC -> E + D
            #       ZC -> E + A
            zc_leave = zc0 * p_leave_c
            zc_to_d = zc_leave * branch_d
            zc_to_a = zc_leave - zc_to_d

            zc = zc0 - zc_leave
            d += zc_to_d
            a += zc_to_a

            # 5) Existing crystalline polymer binds enzyme:
            #       E + C -> ZC
            c_to_zc = c0 * p_attack_c
            c = c0 - c_to_zc
            zc += c_to_zc

            # Free active enzyme:
            # binding consumes E; turnover releases E.
            e_poly = e0 - c_to_zc - a_to_za + zc_leave + za_to_d
            if e_poly < 0.0:
                e_poly = 0.0

            M[STATE_C,  i, j] = c
            M[STATE_A,  i, j] = a
            M[STATE_ZC, i, j] = zc
            M[STATE_ZA, i, j] = za
            M[STATE_D,  i, j] = d
            M[STATE_V,  i, j] = v
            E[i, j] = e_poly

    # Dirichlet active-enzyme boundary condition.
    for j in range(ny):
        E[0, j] = ET
        E[nx - 1, j] = ET

    for i in range(nx):
        E[i, 0] = ET
        E[i, ny - 1] = ET

    total_initial_mass = float(nx * ny)
    return released_mass / total_initial_mass


