def _centre_crop_phase_rgb_for_sem(rgb, window_mm=SEM_COMPARE_CENTER_WINDOW_MM):
    rgb = np.asarray(rgb)

    if rgb.ndim != 3 or rgb.shape[1] < 1:
        return rgb

    window_mm = float(np.clip(window_mm, DX, LY))
    pixels_per_mm_y = rgb.shape[1] / float(LY)

    crop_width = int(round(window_mm * pixels_per_mm_y))
    crop_width = max(1, min(crop_width, rgb.shape[1]))

    j0 = (rgb.shape[1] - crop_width) // 2

    return rgb[:, j0:j0 + crop_width, :]


