def degraded_fraction_limits(series):
    """Choose a linear display range in percent from the actual recorded values."""
    finite = []
    for values in series:
        a = np.asarray(values, dtype=float).ravel()
        finite.extend(a[np.isfinite(a)])
    if not finite:
        return (0.0, 1.0)
    low, high = min(0.0, min(finite)), max(0.0, max(finite))
    if low == high:
        return (0.0, 1.0)  # Genuine all-zero output is annotated, never inflated.
    margin = .12 * (high - low)
    return (low - margin if low < 0 else 0.0, high + margin)


def style_degraded_fraction_axis(ax, values, limits):
    """Show small percentages clearly while leaving the curve values unchanged."""
    ax.set_ylim(*limits)
    ax.yaxis.set_major_locator(MaxNLocator(nbins=5, min_n_ticks=3))
    formatter = ScalarFormatter(useMathText=True, useOffset=False)
    formatter.set_scientific(True)
    formatter.set_powerlimits((-3, 3))
    ax.yaxis.set_major_formatter(formatter)
    ax.set_ylabel('Degraded fraction (%)', fontsize=18, fontweight='bold')
    ax.set_xlabel('Time (h)', fontsize=18, fontweight='bold')
    ax.tick_params(axis='both', labelsize=16)
    for label in ax.get_xticklabels() + ax.get_yticklabels():
        label.set_fontweight('bold')
    offset = ax.yaxis.get_offset_text()
    offset.set_fontsize(16)
    offset.set_fontweight('bold')
    a = np.asarray(values, dtype=float)
