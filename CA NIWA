def redraw_saved_curves():
    """Regenerate grade and combined curve plots from existing simulation CSVs."""
    results = {}
    required = {'time_h', 'WL_model_pct', 'Xc_model_pct',
                'Degraded_fraction_pct', 'pH_model', 'P_free'}
    for grade in GRADES:
        file = OUTPUT_ROOT / grade / f'{grade}_NIWA_model_timeseries.csv'
        if not file.exists():
            raise FileNotFoundError(
                f'Missing saved results: {file}. Set REDRAW_CURVES_ONLY=False to simulate first.')
        rec = pd.read_csv(file)
        missing = required.difference(rec.columns)
        if missing:
            raise ValueError(f'{file.name}: missing columns {sorted(missing)}.')
        if len(rec) != len(T_EXP) or not np.allclose(rec['time_h'], T_EXP):
            raise ValueError(f'{file.name}: saved times do not match T_EXP.')
        results[grade] = rec
    for grade, rec in results.items():
        save_grade_curves(grade, rec, OUTPUT_ROOT / grade)
        vals = rec['Degraded_fraction_pct'].to_numpy(dtype=float)
        vals = vals[np.isfinite(vals)]
        if vals.size:
            print(f'{grade}: degraded fraction range = {vals.min():.6g} to {vals.max():.6g} %.')
