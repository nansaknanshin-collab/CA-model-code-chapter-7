# ================================================================

def simulate(grade, seed, save_snapshots=True):
    p = PARAMS[grade]

    M, E, init_stats = initialise_lattice(DATA[grade]['XC0'], seed)

    columns = [
        'time_h',
        'WL_model_pct',
        'Xc_model_pct',
        'Degraded_fraction_pct',
        'pH_model',
        'P_free',
        'C_pct',
        'A_pct',
        'ZC_pct',
        'ZA_pct',
        'D_pct',
        'V_pct',
        'E_mean',
        'max_cell_mass_error',
    ]

    rec = np.zeros((len(T_EXP), len(columns)), dtype=float)
    snapshots = {}

    product_pool = 0.0
    phi = np.zeros((NX, NY), dtype=np.float64)

    for step in range(NSTEPS + 1):
        if step in REC_STEPS:
            idx = REC_STEPS[step]
            vals = observables(M, E, product_pool, p['alpha'])

            rec[idx, :] = [
                step * DT,
                vals['WL'],
                vals['Xc'],
                vals['Degraded_fraction'],
                vals['pH'],
                vals['P_free'],
                vals['C_pct'],
                vals['A_pct'],
                vals['ZC_pct'],
                vals['ZA_pct'],
                vals['D_pct'],
                vals['V_pct'],
                vals['E_mean'],
                vals['max_cell_mass_error'],
            ]

        if save_snapshots and step in SNAP_STEPS:
            snapshots[SNAP_STEPS[step]] = dict(
                mass_fractions=np.transpose(M, (1, 2, 0)).astype(np.float32),
                state_mass_totals=np.sum(M, axis=(1, 2)).copy(),
                E=E.copy(),
                P_free=float(product_pool),
            )

        if step == NSTEPS:
            break

        # Sequential update of one time step DT:
        # reaction step over DT, then enzyme transport step over DT.
        # The porosity used for transport is taken after the reaction step.

        released = reaction_step(
            M,
            E,
            p['k2'],
            p['kc'],
            p['km'],
            p['k1'],
            p['ka'],
            p['ke'],
            DT,
            E_T,
        )
        product_pool = max(product_pool + released, 0.0)

        fill_porosity(phi, M)

        diffuse_x(
            E,
            phi,
            p['De0'],
            DT,
            DX,
            E_T,
        )

        diffuse_y(
            E,
            phi,
            p['De0'],
            DT,
            DY,
            E_T,
        )

    out = pd.DataFrame(rec, columns=columns)
    out.attrs['initialisation_stats'] = init_stats

    return out, snapshots


