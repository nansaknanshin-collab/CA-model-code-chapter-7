# ================================================================

@njit(cache=False)
def fill_porosity(phi, M):
    """Set local porosity equal to the local void fraction V."""
    nx = phi.shape[0]
    ny = phi.shape[1]

    for i in range(nx):
        for j in range(ny):
            value = M[STATE_V, i, j]

            if value < 0.0:
                value = 0.0
            elif value > 1.0:
                value = 1.0

            phi[i, j] = value


@njit(cache=False)
def diffuse_x(E, phi, De0, dt, dx, ET):
    """
    Implicit diffusion solve in the thickness direction.

    Face diffusivity:
        D_E,f = De0 * max(phi_L, phi_R)
    """
    nx, ny = E.shape
    m = nx - 2

    a = np.empty(m)
    b = np.empty(m)
    c = np.empty(m)
    d = np.empty(m)
    cp = np.empty(m)
    rhs_p = np.empty(m)
    sol = np.empty(m)

    inv = 1.0 / (dx * dx)

    for j in range(ny):
        for q in range(m):
            i = q + 1

            Dl = De0 * max(phi[i - 1, j], phi[i, j])
            Dr = De0 * max(phi[i, j], phi[i + 1, j])

            ll = dt * Dl * inv
            lr = dt * Dr * inv

            a[q] = -ll
            b[q] = 1.0 + ll + lr
            c[q] = -lr
            d[q] = E[i, j]

        d[0] -= a[0] * ET
        a[0] = 0.0

        d[m - 1] -= c[m - 1] * ET
        c[m - 1] = 0.0

        cp[0] = c[0] / b[0]
        rhs_p[0] = d[0] / b[0]

        for q in range(1, m):
            den = b[q] - a[q] * cp[q - 1]

            if q < m - 1:
                cp[q] = c[q] / den

            rhs_p[q] = (d[q] - a[q] * rhs_p[q - 1]) / den

        sol[m - 1] = rhs_p[m - 1]

        for q in range(m - 2, -1, -1):
            sol[q] = rhs_p[q] - cp[q] * sol[q + 1]

        E[0, j] = ET
        E[nx - 1, j] = ET

        for q in range(m):
            E[q + 1, j] = sol[q]


@njit(cache=False)
def diffuse_y(E, phi, De0, dt, dy, ET):
    """
    Implicit diffusion solve in the longitudinal direction.

    Face diffusivity:
        D_E,f = De0 * max(phi_L, phi_R)
    """
    nx, ny = E.shape
    m = ny - 2

    a = np.empty(m)
    b = np.empty(m)
    c = np.empty(m)
    d = np.empty(m)
    cp = np.empty(m)
    rhs_p = np.empty(m)
    sol = np.empty(m)

    inv = 1.0 / (dy * dy)

    for i in range(1, nx - 1):
        for q in range(m):
            j = q + 1

            Dl = De0 * max(phi[i, j - 1], phi[i, j])
            Dr = De0 * max(phi[i, j], phi[i, j + 1])

            ll = dt * Dl * inv
            lr = dt * Dr * inv

            a[q] = -ll
            b[q] = 1.0 + ll + lr
            c[q] = -lr
            d[q] = E[i, j]

        d[0] -= a[0] * ET
        a[0] = 0.0

        d[m - 1] -= c[m - 1] * ET
        c[m - 1] = 0.0

        cp[0] = c[0] / b[0]
        rhs_p[0] = d[0] / b[0]

        for q in range(1, m):
            den = b[q] - a[q] * cp[q - 1]

            if q < m - 1:
                cp[q] = c[q] / den

            rhs_p[q] = (d[q] - a[q] * rhs_p[q - 1]) / den

        sol[m - 1] = rhs_p[m - 1]

        for q in range(m - 2, -1, -1):
            sol[q] = rhs_p[q] - cp[q] * sol[q + 1]

        E[i, 0] = ET
        E[i, ny - 1] = ET

        for q in range(m):
            E[i, q + 1] = sol[q]

    for j in range(ny):
        E[0, j] = ET
        E[nx - 1, j] = ET

    for i in range(nx):
        E[i, 0] = ET
        E[i, ny - 1] = ET


# ================================================================
# OBSERVABLES
# ================================================================

def observables(M, E, product_pool, alpha):
    masses = np.sum(M, axis=(1, 2))

    nC  = float(masses[STATE_C])
    nA  = float(masses[STATE_A])
    nZC = float(masses[STATE_ZC])
    nZA = float(masses[STATE_ZA])
    nD  = float(masses[STATE_D])
    nV  = float(masses[STATE_V])

    total_initial_mass = float(NX * NY)
    solid = nC + nA + nZC + nZA + nD

    # Weight loss is the fraction transferred to void.
    wl = 100.0 * nV / total_initial_mass

    # Remaining crystallinity is crystalline polymer plus crystalline complex
    # relative to the mass that remains in the solid.
    xc = 100.0 * (nC + nZC) / solid if solid > 0.0 else 0.0

    # Retained degraded polymer among the remaining solid.
    degraded_fraction = 100.0 * nD / solid if solid > 0.0 else 0.0

    # Well-mixed product-pH relation transferred from the fitted PDE model.
    ph = PH0 - alpha * product_pool

    cell_sum = np.sum(M, axis=0)
    max_mass_error = float(np.max(np.abs(cell_sum - 1.0)))

    return dict(
        WL=wl,
        Xc=xc,
        Degraded_fraction=degraded_fraction,
        pH=ph,
        P_free=float(product_pool),
        C_pct=100.0 * nC / total_initial_mass,
        A_pct=100.0 * nA / total_initial_mass,
        ZC_pct=100.0 * nZC / total_initial_mass,
        ZA_pct=100.0 * nZA / total_initial_mass,
        D_pct=100.0 * nD / total_initial_mass,
        V_pct=100.0 * nV / total_initial_mass,
        E_mean=float(np.mean(E)),
        max_cell_mass_error=max_mass_error,
    )


