# PCL6300 POROSITY STUDY (NON-POROUS FILM AND POROUS SCAFFOLDS)
# ================================================================
# Single self-contained script: the NIWA CA above (random C/A assignment,
# PDE parameters unchanged, E_T = 0.5) followed by the porosity study.
# No other file is needed.

import sys
from scipy import ndimage
from scipy.spatial import cKDTree

g = sys.modules[__name__]           # the CA model defined above

GRADE = 'PCL6300'
POROSITIES = [0.0, 0.15, 0.30, 0.50]
SEED = g.SEED0                      # same polymer morphology for every case
PORE_SEED = g.SEED0 + 777           # same pore-placement stream for every case
SNAP_TIMES = [0.0, 2.0, 4.0, 8.0, 12.0, 20.0]
WINDOW_MM = 0.31                    # central window for the morphology panels
SOLID_CUT = 0.01                    # connectivity analysis only
PORE_GEOMETRY = 'walls'             # 'walls' or 'random'
WALL_THICKNESS_MM = 0.018           # target wall thickness for 'walls' (about 2 cells at 0.010 mm)
# Pore spacing grows with porosity so that the walls keep about the same
# thickness: spacing = 2 * wall / (1 - V0). Higher porosity therefore means
# larger pores separated by walls of similar thickness, as in scaffolds.

OUT = g.BASE_DIR / f'MA_NIWA_PCL6300_POROSITY_STUDY_RANDOM_{PORE_GEOMETRY.upper()}'
OUT.mkdir(parents=True, exist_ok=True)

COLOURS = ['black', 'tab:blue', 'tab:orange', 'tab:green']


def wall_architecture(cryst, xc0, n_pore):
    """
    Pores are the interiors of a random tessellation, so the polymer forms
    continuous walls between pores. The crystalline/amorphous assignment of
    the polymer cells is the random one of the non-porous lattice; randomly
    chosen polymer cells are then switched between C and A until the
    crystalline fraction of the remaining polymer is exactly xc0.
    """
    nx, ny = cryst.shape
    rng = np.random.default_rng(PORE_SEED)
    v0 = n_pore / float(nx * ny)
    spacing = 2.0 * WALL_THICKNESS_MM / max(1.0 - v0, 1e-6) / g.DX
    n_centres = max(2, int(round(nx * ny / spacing ** 2)))
    centres = np.column_stack([rng.uniform(-0.5, nx - 0.5, n_centres),
                               rng.uniform(-0.5, ny - 0.5, n_centres)])
    pts = np.stack(np.meshgrid(np.arange(nx), np.arange(ny), indexing='ij'),
                   -1).reshape(-1, 2)
    dist, _ = cKDTree(centres).query(pts, k=2)
    d = 0.5 * (dist[:, 1] - dist[:, 0])
    order = np.argsort(-d, kind='stable')
    pores = order[:n_pore]
    polymer = np.ones(nx * ny, dtype=bool)
    polymer[pores] = False

    c = cryst.ravel().copy()
    target_c = int(round(xc0 * polymer.sum()))
    r = np.random.default_rng(PORE_SEED + 1)
    diff = int((c & polymer).sum()) - target_c
    if diff > 0:         # too crystalline: random C cells become A
        cand = np.flatnonzero(c & polymer)
        c[r.choice(cand, size=diff, replace=False)] = False
    elif diff < 0:       # too amorphous: random A cells become C
        cand = np.flatnonzero(~c & polymer)
        c[r.choice(cand, size=-diff, replace=False)] = True
    return pores, c.reshape(nx, ny)


def make_initialiser(v0):
    """Return an initialise_lattice replacement with initial porosity v0."""

    def initialise_porous(xc0, seed):
        M, E, stats = g.initialise_lattice_base(xc0, seed)
        if v0 <= 0.0:
            return M, E, stats
        n = g.NX * g.NY
        n_pore = int(round(v0 * n))
        if PORE_GEOMETRY == 'walls':
            pores, cryst = wall_architecture(M[g.STATE_C] > 0.5, xc0, n_pore)
            M[g.STATE_C] = cryst.astype(float)
            M[g.STATE_A] = (~cryst).astype(float)
        else:
            n_pore_c = int(round(n_pore * xc0))
            rng = np.random.default_rng(PORE_SEED)
            c_cells = np.flatnonzero(M[g.STATE_C].ravel() > 0.5)
            a_cells = np.flatnonzero(M[g.STATE_A].ravel() > 0.5)
            pores = np.concatenate([
                rng.choice(c_cells, n_pore_c, replace=False),
                rng.choice(a_cells, n_pore - n_pore_c, replace=False),
            ])
        for s in range(g.N_STATES):
            M[s].ravel()[pores] = 0.0
        M[g.STATE_V].ravel()[pores] = 1.0
        E.ravel()[pores] = g.E_T            # liquid-filled, enzyme present
        stats = dict(stats, initial_pore_cells=int(n_pore),
                     initial_porosity=v0)
        return M, E, stats

    return initialise_porous


def polymer_connectivity(snap):
    """Share of remaining polymer mass in the largest face-connected piece."""
    solid = 1.0 - snap['mass_fractions'][:, :, g.STATE_V]
    lab, n = ndimage.label(solid >= SOLID_CUT)
    if n == 0:
        return np.nan, 0
    w = ndimage.sum(solid, lab, index=np.arange(1, n + 1))
    return 100.0 * w.max() / solid.sum(), int(n)


def crop(rgb):
    ppm = rgb.shape[1] / g.LY
    w = int(round(WINDOW_MM * ppm))
    j0 = (rgb.shape[1] - w) // 2
    return rgb[:, j0:j0 + w]


def porosity_main():
    g.initialise_lattice_base = g.initialise_lattice
    saved_snap_steps = dict(g.SNAP_STEPS)
    g.SNAP_STEPS = {int(round(t / g.DT)): float(t) for t in SNAP_TIMES}

    results, snaps, rows = {}, {}, []
    for v0 in POROSITIES:
        g.initialise_lattice = make_initialiser(v0)
        rec, sn = g.simulate(GRADE, SEED, save_snapshots=True)
        v_frac0 = rec['V_pct'].iloc[0] / 100.0
        rec['WL_porous_pct'] = (rec['V_pct'] / 100.0 - v_frac0) / (1.0 - v_frac0) * 100.0
        results[v0], snaps[v0] = rec, sn
        for t in SNAP_TIMES:
            share, pieces = polymer_connectivity(sn[t])
            rows.append(dict(initial_porosity=v0, time_h=t,
                             largest_piece_pct=share, pieces=pieces))
        print(f'V0 = {v0:.2f}: WL(8 h) = {np.interp(8, rec.time_h, rec.WL_porous_pct):.1f}%, '
              f'WL(20 h) = {rec.WL_porous_pct.iloc[-1]:.1f}%, '
              f'Xc(8 h) = {np.interp(8, rec.time_h, rec.Xc_model_pct):.1f}%', flush=True)
    g.initialise_lattice = g.initialise_lattice_base
    g.SNAP_STEPS = saved_snap_steps

    pd.concat([r.assign(initial_porosity=v) for v, r in results.items()]).to_csv(
        OUT / 'PCL6300_POROSITY_COMPARISON_timeseries.csv', index=False)
    conn = pd.DataFrame(rows)
    conn.to_csv(OUT / 'PCL6300_POROSITY_polymer_connectivity.csv', index=False)

    # Curves (no titles; information in legends).
    for col, key, ylabel, ylim, name, marker in (
            ('WL_porous_pct', 'WL', 'Weight loss (%)', (0, 100), 'weight_loss', 'o'),
            ('Xc_model_pct', 'Xc', 'Crystallinity (%)', (0, 70), 'crystallinity', 's')):
        fig, ax = plt.subplots(figsize=(8, 5.5))
        ax.plot(g.T_EXP, g.DATA[GRADE][key], marker=marker, linestyle='none',
                color='black', ms=9, markerfacecolor='white', markeredgewidth=1.6,
                zorder=10, label='PCL6300 data (film)')
        for (v0, rec), colr in zip(results.items(), COLOURS):
            t, y = g.smooth_curve(rec[col])
            ax.plot(t, np.clip(y, 0, 100), lw=3, color=colr,
                    label=f'{100 * v0:g}%')
        ax.set(xlabel='Time (h)', ylabel=ylabel, xlim=(-0.5, 20.5), ylim=ylim)
        ax.grid(alpha=0.3)
        ax.legend(title='Initial porosity', fontsize=10, title_fontsize=11)
        fig.tight_layout()
        g.savefig_windows_safe(fig, OUT / f'PCL6300_POROSITY_COMPARISON_{name}.png', dpi=600)
        plt.close(fig)

    legend = list(g.PHASE_LEGEND)       # one unique colour per species

    # Initial morphology, full width, one row per porosity.
    fig, axes = plt.subplots(1, len(POROSITIES), figsize=(16, 3.4))
    for ax, v0 in zip(axes, POROSITIES):
        rgb = crop(g.fraction_preserving_phase_image(snaps[v0][0.0]))
        ax.imshow(rgb, interpolation='nearest', aspect='equal')
        ax.set_xticks([]); ax.set_yticks([])
        ax.set_xlabel(f'{100 * v0:g}%', fontsize=13, fontweight='bold')
    fig.legend(handles=legend, loc='lower center', ncol=6, fontsize=11)
    fig.tight_layout(rect=(0, 0.1, 1, 1))
    g.savefig_windows_safe(fig, OUT / 'PCL6300_INITIAL_MORPHOLOGY_ALL_POROSITIES.png', dpi=300)
    plt.close(fig)

    # Morphology evolution: rows = times, columns = porosities.
    fig, axes = plt.subplots(len(SNAP_TIMES), len(POROSITIES),
                             figsize=(14, 2.3 * len(SNAP_TIMES) + 1), squeeze=False)
    for r, t in enumerate(SNAP_TIMES):
        for c, v0 in enumerate(POROSITIES):
            ax = axes[r, c]
            ax.imshow(crop(g.fraction_preserving_phase_image(snaps[v0][t])),
                      interpolation='nearest', aspect='equal')
            ax.set_xticks([]); ax.set_yticks([])
            if r == len(SNAP_TIMES) - 1:
                ax.set_xlabel(f'{100 * v0:g}%', fontsize=13, fontweight='bold')
            if c == 0:
                ax.set_ylabel(f'{t:g} h', fontsize=13, fontweight='bold',
                              rotation=0, ha='right', va='center')
    fig.legend(handles=legend, loc='lower center', ncol=6, fontsize=12)
    fig.tight_layout(rect=(0, 0.04, 1, 1))
    g.savefig_windows_safe(fig, OUT / 'PCL6300_ZOOMED_MORPHOLOGY_ALL_SPECIMENS_PANEL.png', dpi=300)
    plt.close(fig)

    # Full-specimen morphology evolution: one figure per initial porosity,
    # rows = times, each panel the whole 0.30 mm x 10 mm cross-section.
    for v0 in POROSITIES:
        fig, axes = plt.subplots(len(SNAP_TIMES), 1,
                                 figsize=(22, 2.0 * len(SNAP_TIMES) + 1.5),
                                 squeeze=False)
        for r, t in enumerate(SNAP_TIMES):
            ax = axes[r, 0]
            ax.imshow(g.fraction_preserving_phase_image(snaps[v0][t]),
                      extent=[0.0, g.LY, g.LX, 0.0], origin='upper',
                      interpolation='nearest', aspect='auto')
            ax.set_xticks([]); ax.set_yticks([])
            ax.text(-0.012, 0.5, f't = {t:g} h', transform=ax.transAxes,
                    ha='right', va='center', fontsize=16, fontweight='bold')
        fig.legend(handles=legend + [Patch(facecolor='none', edgecolor='none',
                   label=f'initial porosity {100 * v0:g}%')],
                   loc='lower center', ncol=7, fontsize=13)
        fig.subplots_adjust(left=0.08, right=0.99, top=0.98, bottom=0.10,
                            hspace=0.12)
        g.savefig_windows_safe(
            fig, OUT / f'PCL6300_FULL_MORPHOLOGY_porosity_{int(round(100 * v0)):02d}.png',
            dpi=300)
        plt.close(fig)

    # Combined full-specimen morphology: for each time, one strip per initial
    # porosity, each strip the whole 0.30 mm x 10 mm cross-section drawn to
    # scale.
    full_times = [0.0, 2.0, 4.0, 8.0, 20.0]
    n_rows = len(full_times) * len(POROSITIES)
    fig, axes = plt.subplots(n_rows, 1, figsize=(16, 0.62 * n_rows + 1.2),
                             squeeze=False)
    for a, t in enumerate(full_times):
        for b, v0 in enumerate(POROSITIES):
            ax = axes[a * len(POROSITIES) + b, 0]
            ax.imshow(g.fraction_preserving_phase_image(snaps[v0][t]),
                      extent=[0.0, g.LY, g.LX, 0.0], origin='upper',
                      interpolation='nearest', aspect='equal')
            ax.set_xticks([]); ax.set_yticks([])
            ax.text(-0.005, 0.5, f'{100 * v0:g}%', transform=ax.transAxes,
                    ha='right', va='center', fontsize=10)
            if b == 0:
                ax.text(-0.055, -1.5, f'{t:g} h', transform=ax.transAxes,
                        ha='right', va='center', fontsize=13,
                        fontweight='bold')
    fig.legend(handles=legend, loc='lower center', ncol=6, fontsize=12)
    fig.subplots_adjust(left=0.08, right=0.995, top=0.995, bottom=0.06,
                        hspace=0.35)
    g.savefig_windows_safe(fig, OUT / 'PCL6300_FULL_MORPHOLOGY_ALL_POROSITIES.png',
                           dpi=300)
    plt.close(fig)

    print(conn[conn.time_h.isin([0.0, 12.0])].round(2).to_string(index=False))
    print(f'Output folder: {OUT}')


