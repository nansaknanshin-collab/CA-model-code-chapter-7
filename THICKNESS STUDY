def time_to_threshold(time_h, y_pct, threshold_pct):
    t = np.asarray(time_h, dtype=float)
    y = np.asarray(y_pct, dtype=float)

    idx = np.flatnonzero(y >= float(threshold_pct))
    if idx.size == 0:
        return np.nan

    k = int(idx[0])
    if k == 0:
        return float(t[0])

    t0, t1 = t[k - 1], t[k]
    y0, y1 = y[k - 1], y[k]

    if y1 == y0:
        return float(t1)

    return float(t0 + (threshold_pct - y0) * (t1 - t0) / (y1 - y0))


def value_at_time(time_h, y, t_query):
    t = np.asarray(time_h, dtype=float)
    if t_query > t[-1]:
        return np.nan
    return float(np.interp(t_query, t, np.asarray(y, dtype=float)))


def front_velocity(time_h, depth_mm, t_lo=1.0, t_hi=8.0):
    """
    Erosion-front velocity (mm/h per face): least-squares slope of eroded
    depth against time over a FIXED time window [t_lo, t_hi], identical for
    every thickness. The window starts after the initial start-up transient
    and ends before the fronts meet at the mid-plane of the thinnest film
    (about 9 h for 0.3 mm), so all thicknesses are compared over the same
    interval and any difference reflects thickness, not the fitting window.
    """
    t = np.asarray(time_h, dtype=float)
    dep = np.asarray(depth_mm, dtype=float)

    mask = (t >= t_lo) & (t <= t_hi)
    if np.count_nonzero(mask) < 3:
        return np.nan

    slope, _ = np.polyfit(t[mask], dep[mask], 1)
    return float(slope)


def build_summary_row(grade, thickness_mm, result):
    geom = result.attrs['geometry']
    t = result['time_h']
    wl = result['WL_model_pct_mean']

    return dict(
        Polymer=grade,
        Model=MODEL_NAME,
        Out_of_plane_length_mm=OUT_OF_PLANE_LENGTH_MM,
        Modelled_width_mm=geom['width_mm'],
        Thickness_mm=geom['thickness_mm'],
        Edges_exposed=EXPOSE_EDGES,
        NX=geom['nx'],
        NY=geom['ny'],
        Total_cells=geom['total_cells'],
        DX_mm=geom['dx'],
        DY_mm=geom['dy'],
        Cell_aspect_error_pct=100.0 * geom['cell_aspect_error'],
        Mass_ratio_to_ref=geom['mass_ratio_to_ref'],
        T_end_h=float(t.iloc[-1]),
        WL_at_T_compare_pct=value_at_time(t, wl, T_COMPARE),
        Xc_at_T_compare_pct=value_at_time(
            t, result['Xc_model_pct_mean'], T_COMPARE
        ),
        Depth_at_T_compare_mm=value_at_time(
            t, result['Eroded_depth_mm_mean'], T_COMPARE
        ),
        pH_at_T_compare=value_at_time(t, result['pH_model_mean'], T_COMPARE),
        Final_WL_pct=float(wl.iloc[-1]),
        Final_WL_sd_pct=float(result['WL_model_pct_sd'].iloc[-1]),
        Final_Xc_pct=float(result['Xc_model_pct_mean'].iloc[-1]),
        Final_Xc_sd_pct=float(result['Xc_model_pct_sd'].iloc[-1]),
        Final_degraded_fraction_pct=float(
            result['Degraded_fraction_pct_mean'].iloc[-1]
        ),
        Final_P_bath=float(result['P_bath_mean'].iloc[-1]),
        Max_cell_mass_balance_error=float(
            result['max_cell_mass_error_mean'].max()
        ),
        Time_to_25pct_WL_h=time_to_threshold(t, wl, 25.0),
        Time_to_50pct_WL_h=time_to_threshold(t, wl, 50.0),
        Time_to_75pct_WL_h=time_to_threshold(t, wl, 75.0),
        Front_velocity_mm_per_h=front_velocity(
            t, result['Eroded_depth_mm_mean']
        ),
        Mean_runtime_per_replicate_s=result.attrs['mean_runtime_s'],
        Total_runtime_all_replicates_s=result.attrs['total_runtime_s'],
    )


