def geometry_to_grid(thickness_mm, width_mm=IN_PLANE_WIDTH_MM):
    """
    Convert physical geometry to a lattice with approximately the reference
    physical cell size. Thickness is x (NX cells); the 10 mm width is y.
    """
    thickness_mm = float(thickness_mm)
    width_mm = float(width_mm)

    if thickness_mm <= 0.0 or width_mm <= 0.0:
        raise ValueError('Physical dimensions must be positive.')

    nx = max(3, int(round(thickness_mm / TARGET_CELL_MM)))
    ny = max(3, int(round(width_mm / TARGET_CELL_MM)))

    dx = thickness_mm / nx
    dy = width_mm / ny

    return dict(
        thickness_mm=thickness_mm,
        width_mm=width_mm,
        nx=nx,
        ny=ny,
        dx=dx,
        dy=dy,
        cell_area=dx * dy,
        cell_aspect_error=abs(dx - dy) / dx,
        total_cells=nx * ny,
        mass_ratio_to_ref=thickness_mm / REF_THICKNESS_MM,
    )


# ============================================================================
# 6) INITIALISATION
# ============================================================================

def apply_enzyme_bc(E, expose_edges):
    E[0, :] = E_T
    E[-1, :] = E_T
    if expose_edges:
        E[:, 0] = E_T
        E[:, -1] = E_T


def initialise_lattice(nx, ny, xc0, seed):
    """
    Spatially random C/A morphology with exactly round(xc0*N) crystalline
    cells. Each cell starts with one normalised unit of material.
    """
    rng = np.random.default_rng(int(seed))

    n_cells = int(nx * ny)
    n_c = int(round(float(xc0) * n_cells))

    phase = np.zeros(n_cells, dtype=np.uint8)
    phase[:n_c] = 1
    rng.shuffle(phase)
    phase = phase.reshape(nx, ny)

    M = np.zeros((N_STATES, nx, ny), dtype=np.float64)
    M[STATE_C, :, :] = (phase == 1)
    M[STATE_A, :, :] = (phase == 0)

    E = np.zeros((nx, ny), dtype=np.float64)
    apply_enzyme_bc(E, EXPOSE_EDGES)

    return M, E


# ============================================================================
# 7) REACTION HALF-STEP
# ============================================================================

@njit(cache=False)
def reaction_half_step(M, E, k2, kc, km, k1, ka, ke, dt, ET, expose_edges):
    """
    NIWA reaction network over one Strang reaction half-step.

    Eligibility is based on masses present at the START of the half-step:
      * newly generated D cannot erode in that same half-step;
      * newly generated A cannot bind in that same half-step;
      * newly generated ZC/ZA cannot turn over in that same half-step.
    """
    nx = M.shape[1]
    ny = M.shape[2]

    kc_total = kc + km
    p_leave_c = 1.0 - np.exp(-kc_total * dt) if kc_total > 0.0 else 0.0
    branch_d = kc / kc_total if kc_total > 0.0 else 1.0

    p_leave_a = 1.0 - np.exp(-ka * dt) if ka > 0.0 else 0.0
    p_erode = 1.0 - np.exp(-ke * dt) if ke > 0.0 else 0.0

    released_mass = 0.0

    for i in range(nx):
        for j in range(ny):
            c0 = M[STATE_C, i, j]
            a0 = M[STATE_A, i, j]
            zc0 = M[STATE_ZC, i, j]
            za0 = M[STATE_ZA, i, j]
            d0 = M[STATE_D, i, j]
            v0 = M[STATE_V, i, j]

            e0 = E[i, j]
            if e0 < 0.0:
                e0 = 0.0

            p_attack_c = 1.0 - np.exp(-k2 * e0 * dt) if k2 > 0.0 else 0.0
            p_attack_a = 1.0 - np.exp(-k1 * e0 * dt) if k1 > 0.0 else 0.0

            # 1) Existing degraded polymer erodes: D -> P + V
            erode = d0 * p_erode
            d = d0 - erode
            v = v0 + erode
            released_mass += erode

            # 2) Existing amorphous complex degrades: ZA -> E + D
            za_to_d = za0 * p_leave_a
            za = za0 - za_to_d
            d += za_to_d

            # 3) Existing amorphous polymer binds enzyme: E + A -> ZA
            a_to_za = a0 * p_attack_a
            a = a0 - a_to_za
            za += a_to_za

            # 4) Existing crystalline complex: ZC -> E + D or E + A
            zc_leave = zc0 * p_leave_c
            zc_to_d = zc_leave * branch_d
            zc_to_a = zc_leave - zc_to_d

            zc = zc0 - zc_leave
            d += zc_to_d
            a += zc_to_a

            # 5) Existing crystalline polymer binds enzyme: E + C -> ZC
            c_to_zc = c0 * p_attack_c
            c = c0 - c_to_zc
            zc += c_to_zc

            # Free active enzyme bookkeeping.
            e_poly = e0 - c_to_zc - a_to_za + zc_leave + za_to_d
            if e_poly < 0.0:
                e_poly = 0.0

            M[STATE_C, i, j] = c
            M[STATE_A, i, j] = a
            M[STATE_ZC, i, j] = zc
            M[STATE_ZA, i, j] = za
            M[STATE_D, i, j] = d
            M[STATE_V, i, j] = v
            E[i, j] = e_poly

    # Dirichlet active-enzyme boundary condition on the exposed surfaces.
    for j in range(ny):
        E[0, j] = ET
        E[nx - 1, j] = ET

    if expose_edges:
        for i in range(nx):
            E[i, 0] = ET
            E[i, ny - 1] = ET

    total_initial_mass = float(nx * ny)
    return released_mass / total_initial_mass


# ============================================================================
# 8) POROSITY-DEPENDENT ENZYME TRANSPORT
# ============================================================================

@njit(cache=False)
def fill_porosity(phi, M):
    """Local porosity is exactly the local void fraction V."""
    nx = phi.shape[0]
    ny = phi.shape[1]

    for i in range(nx):
        for j in range(ny):
            value = M[STATE_V, i, j]

            if value < 0.0:
                value = 0.0
            elif value > 1.0:
                value = 1.0

            phi[i, j] = value


@njit(cache=False)
def diffuse_x(E, phi, De0, dt, dx, ET):
    """Implicit diffusion through the thickness; Dirichlet at both faces."""
    nx, ny = E.shape
    m = nx - 2

    a = np.empty(m)
    b = np.empty(m)
    c = np.empty(m)
    d = np.empty(m)
    cp = np.empty(m)
    rhs_p = np.empty(m)
    sol = np.empty(m)

    inv = 1.0 / (dx * dx)

    for j in range(ny):
        for q in range(m):
            i = q + 1

            Dl = De0 * max(phi[i - 1, j], phi[i, j])
            Dr = De0 * max(phi[i, j], phi[i + 1, j])

            ll = dt * Dl * inv
            lr = dt * Dr * inv

            a[q] = -ll
            b[q] = 1.0 + ll + lr
            c[q] = -lr
            d[q] = E[i, j]

        d[0] -= a[0] * ET
        a[0] = 0.0

        d[m - 1] -= c[m - 1] * ET
        c[m - 1] = 0.0

        cp[0] = c[0] / b[0]
        rhs_p[0] = d[0] / b[0]

        for q in range(1, m):
            den = b[q] - a[q] * cp[q - 1]

            if q < m - 1:
                cp[q] = c[q] / den

            rhs_p[q] = (d[q] - a[q] * rhs_p[q - 1]) / den

        sol[m - 1] = rhs_p[m - 1]

        for q in range(m - 2, -1, -1):
            sol[q] = rhs_p[q] - cp[q] * sol[q + 1]

        E[0, j] = ET
        E[nx - 1, j] = ET

        for q in range(m):
            E[q + 1, j] = sol[q]


@njit(cache=False)
def diffuse_y_dirichlet(E, phi, De0, dt, dy, ET):
    """Implicit diffusion across the 10 mm width; edges exposed (E = E_T)."""
    nx, ny = E.shape
    m = ny - 2

    a = np.empty(m)
    b = np.empty(m)
    c = np.empty(m)
    d = np.empty(m)
    cp = np.empty(m)
    rhs_p = np.empty(m)
    sol = np.empty(m)

    inv = 1.0 / (dy * dy)

    for i in range(1, nx - 1):
        for q in range(m):
            j = q + 1

            Dl = De0 * max(phi[i, j - 1], phi[i, j])
            Dr = De0 * max(phi[i, j], phi[i, j + 1])

            ll = dt * Dl * inv
            lr = dt * Dr * inv

            a[q] = -ll
            b[q] = 1.0 + ll + lr
            c[q] = -lr
            d[q] = E[i, j]

        d[0] -= a[0] * ET
        a[0] = 0.0

        d[m - 1] -= c[m - 1] * ET
        c[m - 1] = 0.0

        cp[0] = c[0] / b[0]
        rhs_p[0] = d[0] / b[0]

        for q in range(1, m):
            den = b[q] - a[q] * cp[q - 1]

            if q < m - 1:
                cp[q] = c[q] / den

            rhs_p[q] = (d[q] - a[q] * rhs_p[q - 1]) / den

        sol[m - 1] = rhs_p[m - 1]

        for q in range(m - 2, -1, -1):
            sol[q] = rhs_p[q] - cp[q] * sol[q + 1]

        E[i, 0] = ET
        E[i, ny - 1] = ET

        for q in range(m):
            E[i, q + 1] = sol[q]

    for j in range(ny):
        E[0, j] = ET
        E[nx - 1, j] = ET

    for i in range(nx):
        E[i, 0] = ET
        E[i, ny - 1] = ET


@njit(cache=False)
def diffuse_y_noflux(E, phi, De0, dt, dy, ET):
    """
    Implicit diffusion across the 10 mm width with zero flux at both edges.
    All ny cells are unknowns; the face rows x = 0 and x = nx-1 stay at E_T.
    """
    nx, ny = E.shape
    m = ny

    a = np.empty(m)
    b = np.empty(m)
    c = np.empty(m)
    d = np.empty(m)
    cp = np.empty(m)
    rhs_p = np.empty(m)
    sol = np.empty(m)

    inv = 1.0 / (dy * dy)

    for i in range(1, nx - 1):
        for j in range(m):
            if j > 0:
                Dl = De0 * max(phi[i, j - 1], phi[i, j])
            else:
                Dl = 0.0

            if j < m - 1:
                Dr = De0 * max(phi[i, j], phi[i, j + 1])
            else:
                Dr = 0.0

            ll = dt * Dl * inv
            lr = dt * Dr * inv

            a[j] = -ll
            b[j] = 1.0 + ll + lr
            c[j] = -lr
            d[j] = E[i, j]

        cp[0] = c[0] / b[0]
        rhs_p[0] = d[0] / b[0]

        for q in range(1, m):
            den = b[q] - a[q] * cp[q - 1]

            if q < m - 1:
                cp[q] = c[q] / den

            rhs_p[q] = (d[q] - a[q] * rhs_p[q - 1]) / den

        sol[m - 1] = rhs_p[m - 1]

        for q in range(m - 2, -1, -1):
            sol[q] = rhs_p[q] - cp[q] * sol[q + 1]

        for q in range(m):
            E[i, q] = sol[q]

    for j in range(ny):
        E[0, j] = ET
        E[nx - 1, j] = ET


# ============================================================================
# 9) OBSERVABLES
# ============================================================================

def observables(M, E, released_fraction, alpha, mass_ratio, thickness_mm):
    masses = np.sum(M, axis=(1, 2))

    nC = float(masses[STATE_C])
    nA = float(masses[STATE_A])
    nZC = float(masses[STATE_ZC])
    nZA = float(masses[STATE_ZA])
    nD = float(masses[STATE_D])
    nV = float(masses[STATE_V])

    nx = M.shape[1]
    ny = M.shape[2]
    total_initial_mass = float(nx * ny)
    solid = nC + nA + nZC + nZA + nD

    wl = 100.0 * nV / total_initial_mass
    xc = 100.0 * (nC + nZC) / solid if solid > 0.0 else 0.0
    degraded_fraction = 100.0 * nD / solid if solid > 0.0 else 0.0

    # Product in the fixed-volume bath, in units of one reference-film mass.
    p_bath = released_fraction * mass_ratio
    if p_bath <= PH_VALID_P_MAX:
        ph = PH0 - alpha * p_bath
    else:
        ph = np.nan

    # Eroded depth per exposed face (faces-only exposure: two faces).
    eroded_depth_mm = (wl / 100.0) * thickness_mm / 2.0

    cell_sum = np.sum(M, axis=0)
    max_mass_error = float(np.max(np.abs(cell_sum - 1.0)))

    return dict(
        WL=wl,
        Xc=xc,
        Degraded_fraction=degraded_fraction,
        pH=ph,
        P_bath=float(p_bath),
        Eroded_depth_mm=eroded_depth_mm,
        C_pct=100.0 * nC / total_initial_mass,
        A_pct=100.0 * nA / total_initial_mass,
        ZC_pct=100.0 * nZC / total_initial_mass,
        ZA_pct=100.0 * nZA / total_initial_mass,
        D_pct=100.0 * nD / total_initial_mass,
        V_pct=100.0 * nV / total_initial_mass,
        E_mean=float(np.mean(E)),
        max_cell_mass_error=max_mass_error,
    )


# ============================================================================
# 10) ONE THICKNESS / ONE INITIAL-MORPHOLOGY REPLICATE
# ============================================================================

COLUMNS = [
    'time_h',
    'WL_model_pct',
    'Xc_model_pct',
    'Degraded_fraction_pct',
    'pH_model',
    'P_bath',
    'Eroded_depth_mm',
    'C_pct',
    'A_pct',
    'ZC_pct',
    'ZA_pct',
    'D_pct',
    'V_pct',
    'E_mean',
    'max_cell_mass_error',
]


def simulate_one_geometry(grade, thickness_mm, seed, record_times=None):
    settings = GRADE_SETTINGS[grade]
    geom = geometry_to_grid(thickness_mm)

    if record_times is None:
        record_times = RECORD_TIMES

    nx = geom['nx']
    ny = geom['ny']
    dx = geom['dx']
    dy = geom['dy']
    mass_ratio = geom['mass_ratio_to_ref']

    M, E = initialise_lattice(nx, ny, settings['XC0'], seed)
    phi = np.zeros((nx, ny), dtype=np.float64)

    released_fraction = 0.0

    record_times = np.asarray(record_times, dtype=float)
    record_steps = np.rint(record_times / DT).astype(np.int64)
    nsteps = int(round(float(np.max(record_times)) / DT))

    rec = np.zeros((len(record_times), len(COLUMNS)), dtype=float)
    record_lookup = {int(step): idx for idx, step in enumerate(record_steps)}

    for step in range(nsteps + 1):
        if step in record_lookup:
            idx = record_lookup[step]
            vals = observables(
                M, E, released_fraction, settings['alpha'],
                mass_ratio, geom['thickness_mm'],
            )

            rec[idx, :] = [
                step * DT,
                vals['WL'],
                vals['Xc'],
                vals['Degraded_fraction'],
                vals['pH'],
                vals['P_bath'],
                vals['Eroded_depth_mm'],
                vals['C_pct'],
                vals['A_pct'],
                vals['ZC_pct'],
                vals['ZA_pct'],
                vals['D_pct'],
                vals['V_pct'],
                vals['E_mean'],
                vals['max_cell_mass_error'],
            ]

        if step == nsteps:
            break

        # Strang splitting: reaction half -> diffusion full -> reaction half.
        released_1 = reaction_half_step(
            M, E,
            settings['k2'], settings['kc'], settings['km'],
            settings['k1'], settings['ka'], settings['ke'],
            DT / 2.0, E_T, EXPOSE_EDGES,
        )
        released_fraction = max(released_fraction + released_1, 0.0)

        fill_porosity(phi, M)

        diffuse_x(E, phi, settings['De0'], DT, dx, E_T)

        if EXPOSE_EDGES:
            diffuse_y_dirichlet(E, phi, settings['De0'], DT, dy, E_T)
        else:
            diffuse_y_noflux(E, phi, settings['De0'], DT, dy, E_T)

        released_2 = reaction_half_step(
            M, E,
            settings['k2'], settings['kc'], settings['km'],
            settings['k1'], settings['ka'], settings['ke'],
            DT / 2.0, E_T, EXPOSE_EDGES,
        )
        released_fraction = max(released_fraction + released_2, 0.0)

    return pd.DataFrame(rec, columns=COLUMNS), geom


# ============================================================================
# 11) REPLICATE AGGREGATION
# ============================================================================

def simulate_geometry_case(grade, thickness_mm):
    runs = []
    runtimes = []
    geom = None
    seeds = seeds_for_grade(grade)
    record_times = RECORD_TIMES

    for rep, seed in enumerate(seeds, start=1):
        print(f'    replicate {rep}/{N_REP}, seed={seed}')
        t0 = time.time()

        rec, geom = simulate_one_geometry(
            grade=grade,
            thickness_mm=thickness_mm,
            seed=seed,
            record_times=record_times,
        )

        runtimes.append(time.time() - t0)
        runs.append(rec)

    metric_columns = [c for c in COLUMNS if c != 'time_h']

    out = pd.DataFrame({'time_h': record_times})
    ddof = 1 if N_REP > 1 else 0

    for col in metric_columns:
        arr = np.vstack([run[col].to_numpy(dtype=float) for run in runs])
        out[f'{col}_mean'] = np.mean(arr, axis=0)
        out[f'{col}_sd'] = np.std(arr, axis=0, ddof=ddof)

    out.attrs['grade'] = grade
    out.attrs['geometry'] = geom
    out.attrs['mean_runtime_s'] = float(np.mean(runtimes))
    out.attrs['total_runtime_s'] = float(np.sum(runtimes))

    return out


