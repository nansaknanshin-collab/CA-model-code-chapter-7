def save_comparison_plot(grade, all_results, xcol, mean_col, sd_col,
                         xlabel, ylabel, filename, ylim=None):
    fig, ax = plt.subplots(figsize=(9.2, 6.2))

    for thickness_mm, result in all_results:
        x = result[xcol].to_numpy(dtype=float)
        mean = result[mean_col].to_numpy(dtype=float)
        sd = result[sd_col].to_numpy(dtype=float)

        line, = ax.plot(x, mean, lw=2.8, label=f'{thickness_mm:g} mm')

        if N_REP > 1:
            ax.fill_between(
                x, mean - sd, mean + sd,
                alpha=0.12, color=line.get_color(), linewidth=0.0,
            )

    ax.set_xlabel(xlabel, fontsize=18)
    ax.set_ylabel(ylabel, fontsize=18)
    ax.tick_params(axis='both', labelsize=15)
    ax.xaxis.set_major_locator(MaxNLocator(integer=True))
    ax.grid(alpha=0.3)

    if ylim is not None:
        ax.set_ylim(*ylim)

    ax.legend(
        title=grade,
        fontsize=11,
        title_fontsize=11,
        frameon=True,
        ncol=2,
    )

    fig.tight_layout()
    grade_dir = OUTPUT_DIR / grade
    grade_dir.mkdir(parents=True, exist_ok=True)
    path = grade_dir / filename
    fig.savefig(path, dpi=600, bbox_inches='tight', facecolor='white')
    plt.close(fig)

    return path


def save_cross_grade_summary_plot(summary_df, ycol, ylabel, filename,
                                  ylim=None):
    """One summary quantity against thickness for all grades."""
    fig, ax = plt.subplots(figsize=(8.8, 6.0))

    for grade in GRADES:
        d = summary_df.loc[summary_df['Polymer'] == grade]
        d = d.sort_values('Thickness_mm')
        ax.plot(
            d['Thickness_mm'], d[ycol],
            marker='o', ms=7, lw=2.6, label=grade,
        )

    ax.set_xlabel('Thickness (mm)', fontsize=18)
    ax.set_ylabel(ylabel, fontsize=18)
    ax.tick_params(axis='both', labelsize=15)
    ax.grid(alpha=0.3)
    if ylim is not None:
        ax.set_ylim(*ylim)
    ax.legend(fontsize=12, frameon=True)
    fig.tight_layout()

    path = OUTPUT_DIR / filename
    fig.savefig(path, dpi=600, bbox_inches='tight', facecolor='white')
    plt.close(fig)
    return path


